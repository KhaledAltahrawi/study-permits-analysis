# Ignore Jupyter notebook checkpoints
.ipynb_checkpoints/

# Ignore Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore virtual environment folders
venv/
.venv/

# Ignore system files (macOS, Windows)
.DS_Store
Thumbs.db

# Ignore reports (optional — generated HTML files)
reports/

# Ignore temporary data or backups
*.tmp
*.log
